# Obsidian → static site (current workflow)
# Copy this file to .env, then set your vault's absolute path.
# RIDGE_VAULT="/absolute/path/to/your/Obsidian vault"
BLOG_TIMEZONE=Australia/Sydney
PREVIEW_PORT=4173
# For a manual production build; GitHub Actions supplies its actual Pages URL.
# SITE_URL=https://your-name.github.io/ridge/

# Legacy local web composer only (npm run legacy)
PUBLIC_PORT=3333
PUBLIC_HOST=127.0.0.1
EDITOR_PORT=3334
PUBLIC_ORIGIN=http://127.0.0.1:3333
RIDGE_DATA_DIR=./data

# Local mode: editor accepts only localhost hosts and loopback connections.
EDITOR_ACCESS=local

# Later, when deliberately putting the editor behind Tailscale Serve:
# EDITOR_ACCESS=tailscale
# EDITOR_ORIGIN=https://your-server.your-tailnet.ts.net
# TAILSCALE_OWNER=your-tailscale-login@example.com
